/* =====================================================
   BSGA CONSULTING
   GLOBAL STYLES
===================================================== */

/* ---------- Variables ---------- */

:root{

    --primary:#0B1F3A;
    --secondary:#1E5AA8;
    --accent:#2F80ED;

    --text:#1C2430;
    --text-light:#5F6B7A;

    --background:#FFFFFF;
    --background-light:#F7F9FC;

    --border:#E4EAF2;

    --shadow:0 10px 30px rgba(0,0,0,.08);

    --radius:16px;

    --container:1200px;

}

/* ---------- Reset ---------- */

*{

    margin:0;
    padding:0;
    box-sizing:border-box;

}

html{

    scroll-behavior:smooth;

}

body{

    font-family:Inter,Arial,sans-serif;

    color:var(--text);

    background:var(--background);

    line-height:1.6;

}

img{

    display:block;
    max-width:100%;

}

a{

    color:inherit;
    text-decoration:none;

}

.container{

    width:min(92%,var(--container));

    margin:auto;

}
/* =====================================================
   HEADER
===================================================== */

.site-header{

    position:sticky;
    top:0;
    z-index:1000;

    background:#fff;

    border-bottom:1px solid var(--border);

}

.header-container{

    display:flex;
    align-items:center;
    justify-content:space-between;

    min-height:84px;

}

.logo img{

    height:42px;
    width:auto;

}

.main-nav{

    display:flex;
    gap:2rem;

}

.main-nav a{

    font-size:.95rem;
    font-weight:500;

    color:var(--text);

    transition:.25s;

}

.main-nav a:hover{

    color:var(--secondary);

}

.btn-primary{

    display:inline-flex;

    align-items:center;
    justify-content:center;

    padding:.9rem 1.4rem;

    border-radius:999px;

    background:var(--primary);

    color:#fff;

    font-weight:600;

    transition:.25s;

}

.btn-primary:hover{

    background:var(--secondary);

}
.logo-text{

    font-size:1.5rem;

    font-weight:700;

    color:var(--primary);

    letter-spacing:-0.03em;

}
/*=========================================================
LOGO
=========================================================*/

.logo-image{

    height:52px;
    width:auto;
    display:block;

}

/*=========================================================
BUTTONS
=========================================================*/

.btn-primary,
.btn-secondary{

    display:inline-flex;
    align-items:center;
    justify-content:center;

    padding:16px 28px;

    border-radius:999px;

    font-weight:600;

    transition:.3s;

}

.btn-primary{

    background:var(--primary);

    color:#fff;

}

.btn-primary:hover{

    background:var(--secondary);

}

.btn-secondary{

    border:1px solid var(--border);

    background:#fff;

    color:var(--primary);

    margin-left:16px;

}

.btn-secondary:hover{

    background:#F4F7FB;

}

/*=========================================================
HERO
=========================================================*/

.hero{

    padding:80px 0 100px;

}

.hero-container{

    display:grid;

    grid-template-columns:1.1fr .9fr;

    gap:70px;

    align-items:center;

}

.hero-tag{

    display:inline-block;

    color:var(--secondary);

    font-size:.85rem;

    font-weight:700;

    letter-spacing:.12em;

    margin-bottom:20px;

}

.hero h1{

    font-size:clamp(3.4rem,6vw,5.6rem);

    line-height:.95;

    letter-spacing:-0.05em;

    font-weight:800;

    color:var(--primary);

    margin-bottom:32px;

    max-width:700px;

}

.hero p{

    font-size:1.18rem;

    line-height:1.8;

    color:var(--text-light);

    max-width:600px;

    margin-bottom:48px;

}
.hero-image img{

    width:100%;

    aspect-ratio:4/5;

    object-fit:cover;

    border-radius:28px;

    box-shadow:0 35px 80px rgba(11,31,58,.18);

}

