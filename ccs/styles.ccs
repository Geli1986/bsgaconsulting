/*==================================================
BSGA CONSULTING
Version 1.0
==================================================*/


/*==================================================
RESET
==================================================*/

*,
*::before,
*::after{

    margin:0;
    padding:0;
    box-sizing:border-box;

}

html{

    scroll-behavior:smooth;

}

body{

    font-family:"Inter",sans-serif;

    color:#1C2430;

    background:#FFFFFF;

    line-height:1.6;

    -webkit-font-smoothing:antialiased;

}

img{

    display:block;

    max-width:100%;

}

a{

    color:inherit;

    text-decoration:none;

}

button{

    font:inherit;

}


/*==================================================
VARIABLES
==================================================*/

:root{

    --navy:#0B1F3A;
    --blue:#1E5AA8;

    --text:#1C2430;
    --muted:#667085;

    --white:#FFFFFF;

    --light:#F6F8FB;

    --border:#E5EAF2;

    --shadow:0 20px 50px rgba(0,0,0,.08);

    --radius:22px;

    --container:1240px;

}


/*==================================================
LAYOUT
==================================================*/

.container{

    width:min(92%,1240px);

    margin-inline:auto;

}

section{

    padding:100px 0;

}

/*==================================================
HEADER
==================================================*/

.site-header{

    position:sticky;
    top:0;
    z-index:1000;

    background:rgba(255,255,255,.92);

    backdrop-filter:blur(18px);
    -webkit-backdrop-filter:blur(18px);

    border-bottom:1px solid var(--border);

}

.header-container{

    display:flex;
    align-items:center;
    justify-content:space-between;

    height:88px;

}

/*==================================================
LOGO
==================================================*/

.logo{

    display:flex;
    align-items:center;

}

.logo-image{

    height:52px;
    width:auto;

    transition:transform .3s ease;

}

.logo:hover .logo-image{

    transform:scale(1.03);

}

/*==================================================
NAVIGATION
==================================================*/

.main-nav{

    display:flex;
    align-items:center;
    gap:40px;

}

.main-nav a{

    position:relative;

    font-size:.95rem;
    font-weight:500;

    color:var(--text);

    transition:.3s;

}

.main-nav a:hover{

    color:var(--blue);

}

.main-nav a::after{

    content:"";

    position:absolute;

    left:0;
    bottom:-8px;

    width:0;
    height:2px;

    background:var(--blue);

    transition:.3s;

}

.main-nav a:hover::after{

    width:100%;

}
.main-nav a.active{

    color:var(--navy);

    font-weight:700;

}

.main-nav a.active::after{

    width:100%;

}
/*==================================================
BUTTONS
==================================================*/

.btn-primary{

    display:inline-flex;

    align-items:center;
    justify-content:center;

    padding:15px 28px;

    border-radius:999px;

    background:var(--navy);

    color:#fff;

    font-weight:600;

    transition:.3s;

}

.btn-primary:hover{

    transform:translateY(-2px);

    background:var(--blue);

    box-shadow:var(--shadow);

}

.btn-secondary{

    display:inline-flex;

    align-items:center;
    justify-content:center;

    padding:15px 28px;

    border-radius:999px;

    border:1px solid var(--border);

    background:#fff;

    color:var(--navy);

    font-weight:600;

    transition:.3s;

}

.btn-secondary:hover{

    background:var(--light);

}
